*.DS_Store
*.orig
*.swo
*.swp

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/encodings.xml
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml
.idea/misc.xml
.idea/kotlinScripting.xml
.idea/compiler.xml
.idea/kotlinc.xml
.idea/appInsightsSettings.xml
.idea/navEditor.xml

# Android Studio 3 in .gitignore file.
.idea/caches/build_file_checksums.ser
.idea/modules.xml

# Google Services (e.g. APIs or Firebase)
google-services.json

# Airship
airshipconfig.properties

# Thomas Scene fixtures fetched from urbanairship/thomas-layouts
# (see scripts/fetch-layouts.sh / `./gradlew :devapp:fetchLayouts`).
# Messages/ fixtures are tracked in this repo.
devapp/src/main/assets/sample_layouts/Scenes/*
!devapp/src/main/assets/sample_layouts/Scenes/.gitkeep
devapp/src/main/assets/sample_layouts/.layouts.version
