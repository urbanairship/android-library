<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Редактиране на списъка</string>
    <string name="ua_leave_edit_mode">Спиране на редактирането на списъка</string>
    <string name="ua_announce_enter_edit_mode">Редактиране на списъка със съобщения</string>
    <string name="ua_announce_leave_edit_mode">Преглед на списъка със съобщения</string>
    <string name="ua_mark_unread">Маркиране като непрочетено</string>
    <string name="ua_mark_all_read">Маркиране на всички като прочетени</string>
    <string name="ua_delete_all">Изтриване на всички</string>
    <string name="ua_description_mark_read">Маркиране на съобщение като прочетено</string>
    <string name="ua_description_mark_unread">Маркиране на съобщение като непрочетено</string>
    <string name="ua_description_mark_all_read">Маркиране на всички съобщения като прочетени</string>
    <string name="ua_description_delete_all">Изтриване на всички съобщения</string>
    <string name="ua_description_delete">Изтриване на съобщение</string>
    <string name="ua_description_message_list_pane">Списък със съобщения</string>
    <string name="ua_description_message_pane">Съдържание на съобщението</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>съобщение е маркирано като прочетено</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>съобщения са е маркирани като прочетени</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">Изтрито 
        <xliff:g example="1" id="count">%1$d</xliff:g>съобщение</item>
        <item quantity="other">Изтрити 
        <xliff:g example="7" id="count">%1$d</xliff:g>съобщения</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Избрани,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Непрочетено,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, на 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Избери съобщение</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Премахни избора на съобщение</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Прочети съобщението</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d от %2$d</string>
    <string name="ua_selected">Избрано</string>
    <string name="ua_not_selected">Неизбрано</string>
</resources>
