<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">リストを編集</string>
    <string name="ua_leave_edit_mode">リストの編集を終了</string>
    <string name="ua_announce_enter_edit_mode">メッセージリストを編集中</string>
    <string name="ua_announce_leave_edit_mode">メッセージリストを表示中</string>
    <string name="ua_mark_unread">未読としてマーク</string>
    <string name="ua_mark_all_read">すべて既読にする</string>
    <string name="ua_delete_all">すべて削除</string>
    <string name="ua_description_mark_read">メッセージを既読としてマーク</string>
    <string name="ua_description_mark_unread">メッセージを未読としてマーク</string>
    <string name="ua_description_mark_all_read">すべてのメッセージを既読としてマーク</string>
    <string name="ua_description_delete_all">すべてのメッセージを削除</string>
    <string name="ua_description_delete">メッセージを削除</string>
    <string name="ua_description_message_list_pane">メッセージリスト</string>
    <string name="ua_description_message_pane">メッセージ内容</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="other">マークされた 
        <xliff:g example="7" id="count">%1$d</xliff:g>メッセージを既読にする</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="other">削除された 
        <xliff:g example="7" id="count">%1$d</xliff:g>メッセージ</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">が選択されています</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">未読、</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>、 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">メッセージを選択</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">メッセージの選択を解除</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">メッセージを読む</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%2$d個中%1$d個</string>
    <string name="ua_selected">選択済み</string>
    <string name="ua_not_selected">未選択</string>
</resources>
