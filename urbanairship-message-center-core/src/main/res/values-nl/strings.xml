<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Lijst bewerken</string>
    <string name="ua_leave_edit_mode">Stop met lijst bewerken</string>
    <string name="ua_announce_enter_edit_mode">Berichtenlijst wordt bewerkt</string>
    <string name="ua_announce_leave_edit_mode">Berichtenlijst wordt weergegeven</string>
    <string name="ua_mark_unread">Markeren als ongelezen</string>
    <string name="ua_mark_all_read">Alles markeren als gelezen</string>
    <string name="ua_delete_all">Alles verwijderen</string>
    <string name="ua_description_mark_read">Bericht markeren als gelezen</string>
    <string name="ua_description_mark_unread">Bericht markeren als ongelezen</string>
    <string name="ua_description_mark_all_read">Alle berichten markeren als gelezen</string>
    <string name="ua_description_delete_all">Alle berichten verwijderen</string>
    <string name="ua_description_delete">Bericht verwijderen</string>
    <string name="ua_description_message_list_pane">Berichtenlijst</string>
    <string name="ua_description_message_pane">Berichtinhoud</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>bericht gemarkeerd als gelezen</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>berichten gemarkeerd als gelezen</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>bericht verwijderd</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>berichten verwijderd</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Geselecteerd,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Ongelezen,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, op 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Bericht selecteren</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Bericht deselecteren</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Lees bericht</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d van %2$d</string>
    <string name="ua_selected">Geselecteerd</string>
    <string name="ua_not_selected">Niet geselecteerd</string>
</resources>
