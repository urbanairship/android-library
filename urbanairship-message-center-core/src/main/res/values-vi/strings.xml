<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Chỉnh sửa danh sách</string>
    <string name="ua_leave_edit_mode">Dừng chỉnh sửa danh sách</string>
    <string name="ua_announce_enter_edit_mode">Đang chỉnh sửa danh sách tin nhắn</string>
    <string name="ua_announce_leave_edit_mode">Đang xem danh sách tin nhắn</string>
    <string name="ua_mark_unread">Đánh dấu chưa đọc</string>
    <string name="ua_mark_all_read">Đánh dấu tất cả là đã đọc</string>
    <string name="ua_delete_all">Xóa tất cả</string>
    <string name="ua_description_mark_read">Đánh dấu tin nhắn là đã đọc</string>
    <string name="ua_description_mark_unread">Đánh dấu tin nhắn là chưa đọc</string>
    <string name="ua_description_mark_all_read">Đánh dấu tất cả tin nhắn là đã đọc</string>
    <string name="ua_description_delete_all">Xóa tất cả tin nhắn</string>
    <string name="ua_description_delete">Xóa tin nhắn</string>
    <string name="ua_description_message_list_pane">Danh sách tin nhắn</string>
    <string name="ua_description_message_pane">Nội dung tin nhắn</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="other">Đã đánh dấu 
        <xliff:g example="7" id="count">%1$d</xliff:g>tin nhắn là đã đọc</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="other">Đã xóa 
        <xliff:g example="7" id="count">%1$d</xliff:g>tin nhắn</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Đã chọn,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Chưa đọc,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, trên 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Chọn tin nhắn</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Bỏ chọn tin nhắn</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Đọc tin nhắn</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d trong số %2$d</string>
    <string name="ua_selected">Đã chọn</string>
    <string name="ua_not_selected">Chưa chọn</string>
</resources>
