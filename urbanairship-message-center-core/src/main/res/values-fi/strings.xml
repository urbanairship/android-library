<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Muokkaa luetteloa</string>
    <string name="ua_leave_edit_mode">Lopeta luettelon muokkaus</string>
    <string name="ua_announce_enter_edit_mode">Muokataan viestiluetteloa</string>
    <string name="ua_announce_leave_edit_mode">Näytetään viestiluetteloa</string>
    <string name="ua_mark_unread">Merkitse lukemattomaksi</string>
    <string name="ua_mark_all_read">Merkitse kaikki luetuiksi</string>
    <string name="ua_delete_all">Poista kaikki</string>
    <string name="ua_description_mark_read">Merkitse viesti luetuksi</string>
    <string name="ua_description_mark_unread">Merkitse viesti lukemattomaksi</string>
    <string name="ua_description_mark_all_read">Merkitse kaikki viestit luetuiksi</string>
    <string name="ua_description_delete_all">Poista kaikki viestit</string>
    <string name="ua_description_delete">Poista viesti</string>
    <string name="ua_description_message_list_pane">Viestiluettelo</string>
    <string name="ua_description_message_pane">Viestin sisältö</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">Merkittiin 
        <xliff:g example="1" id="count">%1$d</xliff:g>viesti luetuksi</item>
        <item quantity="other">Merkittiin 
        <xliff:g example="7" id="count">%1$d</xliff:g>viestiä luetuiksi</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">Poistettu 
        <xliff:g example="1" id="count">%1$d</xliff:g>viesti</item>
        <item quantity="other">Poistettu 
        <xliff:g example="7" id="count">%1$d</xliff:g>viestiä</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Valittu</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Lukematon,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Valitse viesti</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Poista viestin valinta</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Lue viesti</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d / %2$d</string>
    <string name="ua_selected">Valittu</string>
    <string name="ua_not_selected">Ei valittu</string>
</resources>
