<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Hariri orodha</string>
    <string name="ua_leave_edit_mode">Acha kuhariri orodha</string>
    <string name="ua_announce_enter_edit_mode">Inahariri orodha ya ujumbe</string>
    <string name="ua_announce_leave_edit_mode">Inaonyesha orodha ya ujumbe</string>
    <string name="ua_mark_unread">Weka alama kama haijasomwa</string>
    <string name="ua_mark_all_read">Weka zote alama kama zimesomwa</string>
    <string name="ua_delete_all">Futa zote</string>
    <string name="ua_description_mark_read">Weka ujumbe alama kama umesomwa</string>
    <string name="ua_description_mark_unread">Weka ujumbe alama kama haujasomwa</string>
    <string name="ua_description_mark_all_read">Weka jumbe zote alama kama zimesomwa</string>
    <string name="ua_description_delete_all">Futa jumbe zote</string>
    <string name="ua_description_delete">Futa ujumbe</string>
    <string name="ua_description_message_list_pane">Orodha ya ujumbe</string>
    <string name="ua_description_message_pane">Maudhui ya ujumbe</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">Imetia alama kuwa ujumbe 
        <xliff:g example="1" id="count">%1$d</xliff:g>umesomwa</item>
        <item quantity="other">Imetia alama kuwa barua pepe 
        <xliff:g example="7" id="count">%1$d</xliff:g>zimesomwa</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">Ujumbe 
        <xliff:g example="1" id="count">%1$d</xliff:g>umefutwa</item>
        <item quantity="other">Ujumbe 
        <xliff:g example="7" id="count">%1$d</xliff:g>umefutwa</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Imechaguliwa,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Haijasomwa,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, mnamo 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Chagua ujumbe</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Acha kuchagua ujumbe</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Soma ujumbe</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d ya %2$d</string>
    <string name="ua_selected">Imechaguliwa</string>
    <string name="ua_not_selected">Haijachaguliwa</string>
</resources>
