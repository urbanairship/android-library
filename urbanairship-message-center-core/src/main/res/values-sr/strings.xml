<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Уреди листу</string>
    <string name="ua_leave_edit_mode">Престани са уређивањем листе</string>
    <string name="ua_announce_enter_edit_mode">Уређивање листе порука</string>
    <string name="ua_announce_leave_edit_mode">Преглед листе порука</string>
    <string name="ua_mark_unread">Означи као непрочитано</string>
    <string name="ua_mark_all_read">Означи све као прочитано</string>
    <string name="ua_delete_all">Обриши све</string>
    <string name="ua_description_mark_read">Означи поруку као прочитану</string>
    <string name="ua_description_mark_unread">Означи поруку као непрочитану</string>
    <string name="ua_description_mark_all_read">Означи све поруке као прочитане</string>
    <string name="ua_description_delete_all">Обриши све поруке</string>
    <string name="ua_description_delete">Обриши поруку</string>
    <string name="ua_description_message_list_pane">Листа порука</string>
    <string name="ua_description_message_pane">Садржај поруке</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>порука је означена као прочитана</item>
        <item quantity="few">Означено је као прочитано ( 
        <xliff:g example="7" id="count">%1$d</xliff:g>).</item>
        <item quantity="other">Означено је као прочитано ( 
        <xliff:g example="7" id="count">%1$d</xliff:g>).</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">Избрисана је 
        <xliff:g example="1" id="count">%1$d</xliff:g>порука</item>
        <item quantity="few">Избрисано је 
        <xliff:g example="7" id="count">%1$d</xliff:g>порука</item>
        <item quantity="other">Избрисано је 
        <xliff:g example="7" id="count">%1$d</xliff:g>порука</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Изабрано,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Непрочитано,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Изаберите поруку</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Поништи избор поруке</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Прочитајте поруку</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d од %2$d</string>
    <string name="ua_selected">Изабрано</string>
    <string name="ua_not_selected">Није изабрано</string>
</resources>
