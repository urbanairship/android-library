    <string name="ua_announce_leave_edit_mode">Prikaz seznama sporočil</string>
    <string name="ua_mark_unread">Označi kot neprebrano</string>
    <string name="ua_mark_all_read">Označi vse kot prebrano</string>
    <string name="ua_delete_all">Izbriši vse</string>
    <string name="ua_description_mark_read">Označi sporočilo kot prebrano</string>
    <string name="ua_description_mark_unread">Označi sporočilo kot neprebrano</string>
    <string name="ua_description_mark_all_read">Označi vsa sporočila kot prebrana</string>
    <string name="ua_description_delete_all">Izbriši vsa sporočila</string>
    <string name="ua_description_delete">Izbriši sporočilo</string>
    <string name="ua_description_message_list_pane">Seznam sporočil</string>
    <string name="ua_description_message_pane">Vsebina sporočila</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>sporočilo je označeno kot prebrano</item>
        <item quantity="two">
        <xliff:g example="7" id="count">%1$d</xliff:g>sporočil je bilo označenih kot prebranih</item>
        <item quantity="few">
        <xliff:g example="7" id="count">%1$d</xliff:g>sporočil je bilo označenih kot prebranih</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>sporočil je bilo označenih kot prebranih</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">Izbrisano 
        <xliff:g example="1" id="count">%1$d</xliff:g>sporočilo</item>
        <item quantity="two">Izbrisano je 
        <xliff:g example="7" id="count">%1$d</xliff:g>sporočil</item>
        <item quantity="few">Izbrisano je 
        <xliff:g example="7" id="count">%1$d</xliff:g>sporočil</item>
        <item quantity="other">Izbrisano je 
        <xliff:g example="7" id="count">%1$d</xliff:g>sporočil</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">izbrano,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">neprebrano,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, dne 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Izberite sporočilo</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Prekliči izbor sporočila</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Preberite sporočilo</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d od %2$d</string>
    <string name="ua_selected">Izbrano</string>
    <string name="ua_not_selected">Ni izbrano</string>
</resources>
