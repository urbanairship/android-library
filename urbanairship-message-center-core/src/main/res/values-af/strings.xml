    <string name="ua_description_mark_read">Merk boodskap as gelees</string>
    <string name="ua_description_mark_unread">Merk boodskap as ongelees</string>
    <string name="ua_description_mark_all_read">Merk alle boodskappe as gelees</string>
    <string name="ua_description_delete_all">Verwyder alle boodskappe</string>
