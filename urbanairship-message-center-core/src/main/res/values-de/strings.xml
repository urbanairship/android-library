<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Liste bearbeiten</string>
    <string name="ua_leave_edit_mode">Listenbearbeitung beenden</string>
    <string name="ua_announce_enter_edit_mode">Nachrichtenliste wird bearbeitet</string>
    <string name="ua_announce_leave_edit_mode">Nachrichtenliste wird angezeigt</string>
    <string name="ua_mark_unread">Als ungelesen markieren</string>
    <string name="ua_mark_all_read">Alle als gelesen markieren</string>
    <string name="ua_delete_all">Alle löschen</string>
    <string name="ua_description_mark_read">Nachricht als gelesen markieren</string>
    <string name="ua_description_mark_unread">Nachricht als ungelesen markieren</string>
    <string name="ua_description_mark_all_read">Alle Nachrichten als gelesen markieren</string>
    <string name="ua_description_delete_all">Alle Nachrichten löschen</string>
    <string name="ua_description_delete">Nachricht löschen</string>
    <string name="ua_description_message_list_pane">Nachrichtenliste</string>
    <string name="ua_description_message_pane">Nachrichteninhalt</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>Nachricht als gelesen markiert</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>Nachrichten als gelesen markiert</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">
        <xliff:g example="1" id="count">%1$d</xliff:g>Nachricht gelöscht</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>Nachrichten gelöscht</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Ausgewählt,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Ungelesen,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, am 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Nachricht auswählen</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Nachricht abwählen</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Nachricht lesen</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d von %2$d</string>
    <string name="ua_selected">Ausgewählt</string>
    <string name="ua_not_selected">Nicht ausgewählt</string>
</resources>
