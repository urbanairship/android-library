    <string name="ua_mark_unread">علامت‌گذاری به‌عنوان خوانده‌نشده</string>
    <string name="ua_mark_all_read">علامت‌گذاری همه به‌عنوان خوانده‌شده</string>
    <string name="ua_delete_all">حذف همه</string>
    <string name="ua_description_mark_read">علامت‌گذاری پیام به‌عنوان خوانده‌شده</string>
    <string name="ua_description_mark_unread">علامت‌گذاری پیام به‌عنوان خوانده‌نشده</string>
    <string name="ua_description_mark_all_read">علامت‌گذاری همه پیام‌ها به‌عنوان خوانده‌شده</string>
    <string name="ua_description_delete_all">حذف همه پیام‌ها</string>
    <string name="ua_description_delete">حذف پیام</string>
    <string name="ua_description_message_list_pane">فهرست پیام‌ها</string>
    <string name="ua_description_message_pane">محتوای پیام</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">پیام 
        <xliff:g example="1" id="count">%1$d</xliff:g>به عنوان خوانده شده علامت‌گذاری شد</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>پیام به عنوان خوانده شده علامت‌گذاری شد</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">پیام 
        <xliff:g example="1" id="count">%1$d</xliff:g>حذف شد</item>
        <item quantity="other">
        <xliff:g example="7" id="count">%1$d</xliff:g>پیام حذف شد</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">انتخاب شد،</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">خوانده نشده،</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>، در 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">پیام را انتخاب کنید</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">پیام را لغو انتخاب کنید</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">پیام را بخوانید</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d از %2$d</string>
    <string name="ua_selected">انتخاب شده</string>
    <string name="ua_not_selected">انتخاب نشده</string>
</resources>
