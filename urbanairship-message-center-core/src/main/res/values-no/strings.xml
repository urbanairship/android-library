<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Accessibility -->
    <string name="ua_enter_edit_mode">Rediger liste</string>
    <string name="ua_leave_edit_mode">Stopp redigering av liste</string>
    <string name="ua_announce_enter_edit_mode">Redigerer meldingsliste</string>
    <string name="ua_announce_leave_edit_mode">Viser meldingsliste</string>
    <string name="ua_mark_unread">Merk som ulest</string>
    <string name="ua_mark_all_read">Merk alle som lest</string>
    <string name="ua_delete_all">Slett alle</string>
    <string name="ua_description_mark_read">Merk melding som lest</string>
    <string name="ua_description_mark_unread">Merk melding som ulest</string>
    <string name="ua_description_mark_all_read">Merk alle meldinger som lest</string>
    <string name="ua_description_delete_all">Slett alle meldinger</string>
    <string name="ua_description_delete">Slett melding</string>
    <string name="ua_description_message_list_pane">Meldingsliste</string>
    <string name="ua_description_message_pane">Meldingsinnhold</string>

    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_marked_read">
        <item quantity="one">Merket 
        <xliff:g example="1" id="count">%1$d</xliff:g>melding som lest</item>
        <item quantity="other">Merket 
        <xliff:g example="7" id="count">%1$d</xliff:g>meldinger som lest</item>
    </plurals>
    <!-- Read aloud by screen readers to confirm that selected messages have been marked as read. -->
    <plurals name="ua_mc_description_deleted">
        <item quantity="one">Slettet 
        <xliff:g example="1" id="count">%1$d</xliff:g>melding</item>
        <item quantity="other">Slettet 
        <xliff:g example="7" id="count">%1$d</xliff:g>meldinger</item>
    </plurals>
    <!-- Message item content descriptions. Used on the Inbox (message list) screen. -->
    <!-- Prepended to the content description for messages that are currently selected. -->
    <string name="ua_mc_description_state_selected">Valgt,</string>
    <!-- Prepended to the content description for messages that are currently unread. -->
    <string name="ua_mc_description_state_unread">Ulest,</string>
    <!-- Content description for message items in the message list. Dates will be formatted using
    the DateFormat.LONG format in the current locale. -->
    <string name="ua_mc_description_title_and_date">
    <xliff:g example="This week\'s top deals" id="title">%1$s</xliff:g>, på 
    <xliff:g example="May 1st, 2021" id="sent_date">%2$s</xliff:g></string>
    <!-- Message item actions. Displayed in TalkBack Actions menu when screen reader is active. -->
    <!-- Action that selects the focused message. -->
    <string name="ua_mc_action_select">Velg melding</string>
    <!-- Action that unselects the focused message. -->
    <string name="ua_mc_action_unselect">Fjern markeringen av melding</string>
    <!-- Custom message item tap action. Will be spoken as "Tap to read message" in EN-US. -->
    <string name="ua_mc_action_click">Les melding</string>

    <!-- Accessibility -->
    <string name="ua_score_selected_state_description">%1$d av %2$d</string>
    <string name="ua_selected">Valgt</string>
    <string name="ua_not_selected">Ikke valgt</string>
</resources>
