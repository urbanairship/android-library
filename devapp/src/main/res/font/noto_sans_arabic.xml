<?xml version="1.0" encoding="utf-8"?>
<!--
  Noto Sans Arabic ships no italic face, so an italic Arabic run still falls back to a synthesised
  oblique here and to nothing on iOS. Accepted: the Arabic row in the truncation scene carries no
  emphasis markup.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/noto_sans_arabic_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/noto_sans_arabic_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/noto_sans_arabic_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/noto_sans_arabic_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
